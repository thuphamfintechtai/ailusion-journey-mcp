# ===== Server =====
ENVIRONMENT=development
LOG_LEVEL=INFO
MCP_TRANSPORT=http          # http | stdio | sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ===== Upstream =====
BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_KEY=
LLM_BASE_URL=http://localhost:8001
LLM_API_KEY=

# ===== HTTP client =====
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=2

# ===== Mặc định nghiệp vụ =====
DEFAULT_LANGUAGE=vi
DEFAULT_CURRENCY=VND
