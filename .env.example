# ===== Server =====
ENVIRONMENT=development
LOG_LEVEL=INFO
MCP_TRANSPORT=http          # http | stdio | sse
MCP_HOST=0.0.0.0
MCP_PORT=8002

# ===== Upstream =====
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=
LLM_BASE_URL=http://localhost:8001
LLM_API_KEY=

# ===== SerpApi =====
# Lấy key ở https://serpapi.com/manage-api-key. Nhiều key cách nhau bởi dấu
# phẩy. Client chuyển sang key sau khi key trước bị từ chối (401) hoặc hết
# quota / chạm giới hạn giờ (429). Chi tiết: docs/SERPAPI.md
SERPAPI_API_KEYS=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_TIMEOUT=60
# Fallback: key lỗi bị cho nghỉ bao lâu (giây) trước khi được thử lại.
# 429 giới hạn giờ / 429 hết quota tháng / 401-403 key sai hoặc bị khoá.
SERPAPI_RATE_LIMIT_COOLDOWN=900
SERPAPI_QUOTA_COOLDOWN=21600
SERPAPI_INVALID_KEY_COOLDOWN=86400

# ===== Vietmap =====
# Lấy key ở https://maps.vietmap.vn/console. Nhiều key cách nhau dấu phẩy.
# Gói free: 60.000 transaction/tháng, miễn phí 2 tháng đầu.
VIETMAP_API_KEYS=
VIETMAP_CACHE_TTL=3600

# ===== Tavily =====
# Lấy key ở https://app.tavily.com. Nhiều key cách nhau dấu phẩy.
# Gói free: 1.000 credit/tháng; search basic = 1 credit, advanced = 2, extract = 1 / 5 URL.
TAVILY_API_KEYS=
TAVILY_CACHE_TTL=1800

# ===== WeatherAPI.com =====
# Lấy key ở https://www.weatherapi.com/my/. Nhiều key cách nhau dấu phẩy.
# Gói Free: dự báo 3 ngày; dự báo 14 ngày, future (14-300 ngày) và marine cần gói cao hơn.
WEATHERAPI_API_KEYS=
WEATHERAPI_CACHE_TTL=1800

# ===== Tỷ giá (Vietcombank) =====
# Vietcombank chỉ cho 1 request / 5 phút: giá trị dưới 300 bị nâng lên 300.
FX_CACHE_TTL=1800

# ===== Lịch Việt Nam =====
# Nguồn: rules (luật trong rules.json), google_ics (lịch lễ công khai của
# Google, có nghỉ bù), overrides (overrides/<năm>.json, quyết định từng năm)
CALENDAR_SOURCES=rules,google_ics,overrides
CALENDAR_ICS_TTL=86400
# Để trống: dùng src/data/calendar/rules.json và src/data/calendar/overrides/
CALENDAR_RULES_FILE=
CALENDAR_OVERRIDES_DIR=

# ===== HTTP client =====
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=2

# ===== Mặc định nghiệp vụ =====
DEFAULT_LANGUAGE=vi
DEFAULT_CURRENCY=VND
