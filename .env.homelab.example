# cp .env.homelab.example .env.homelab
# Chạy: docker compose --env-file .env.homelab -f compose.homelab.yaml up -d --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_HOST_PORT=5435
MCP_HOST_PORT=8002

# Nhiều key cách nhau bởi dấu phẩy. Copy từ .env dev.
SERPAPI_API_KEYS=
TAVILY_API_KEYS=
VIETMAP_API_KEYS=
WEATHERAPI_API_KEYS=
